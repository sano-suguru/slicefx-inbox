<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- CS1591: XML doc comments are not required for test code. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- xUnit1051: CancellationToken usage; test helpers use CancellationToken.None intentionally
         since the WasiApp dispatch is in-process and doesn't benefit from cancellation. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- This is a test project, not a Slice host. SliceFxRole=Feature suppresses registration
         codegen (AddSlice()/MapSlices()) so it doesn't clash with Inbox.Server's generated
         AddSlice(). SliceFxAggregateReferences=false suppresses SLICE050/051. -->
    <SliceFxRole>Feature</SliceFxRole>
    <SliceFxAggregateReferences>false</SliceFxAggregateReferences>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="SliceFxRole" />
    <CompilerVisibleProperty Include="SliceFxAggregateReferences" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inbox.Server\Inbox.Server.csproj" />
  </ItemGroup>

</Project>
