<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- dotnet-experimental feed removed: it is only needed for wasi-wasm publish
         (runtime.*.microsoft.dotnet.ilcompiler.llvm alpha + Microsoft.DotNet.ILCompiler.LLVM meta).
         It is registered via RestoreAdditionalProjectSources inside the wasi-wasm condition in
         Inbox.Server.csproj, so non-WASI restores (local dev, CI, tests) no longer attempt to
         reach the Azure DevOps feed and the NuGet audit NU1900 warning is resolved structurally. -->
  </packageSources>
</configuration>
