@page "/items/{Id}"
@inject SliceApiClient Api
@inject RefreshTokenHolder TokenHolder
@inject NavigationManager Nav

<PageTitle>Item — SliceFx Inbox</PageTitle>

@if (_loading)
{
    <p>Loading...</p>
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_item is not null)
{
    <h2><a href="@_item.Url" target="_blank" rel="noopener noreferrer">@_item.Title</a></h2>
    <div class="card">
        <div class="card-url">@_item.Url</div>
        <div class="card-meta" style="margin-top:.4rem">
            <span class="badge @StatusBadgeClass">@_item.Status</span>
            @if (_item.Tags is { Length: > 0 })
            {
                foreach (var tag in _item.Tags)
                {
                    <span class="badge badge-tag">@tag</span>
                }
            }
            <span style="margin-left:.5rem">@_item.Source — @_item.SavedAt.ToString("yyyy-MM-dd HH:mm")</span>
        </div>
        @if (_item.Description is not null)
        {
            <p style="margin-top:.5rem">@_item.Description</p>
        }
    </div>
    <a href="/" class="btn btn-secondary">&larr; Back to inbox</a>
}

@code {
    [Parameter] public string Id { get; set; } = "";

    private bool _loading = true;
    private string? _error;
    private GetItemResponse? _item;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _item = await Api.Items.GetItemAsync(Id);
        }
        catch (SliceApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await TokenHolder.SetAsync(null);
            Nav.NavigateTo("/login");
        }
        catch (SliceApiException ex) when ((int?)ex.StatusCode == 404)
        {
            _error = $"Item '{Id}' not found.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load item: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string StatusBadgeClass => _item?.Status switch
    {
        ItemStatus.Read => "badge-read",
        ItemStatus.Archived => "badge-archived",
        _ => "badge-unread",
    };
}
