@page "/items/{Id}"
@inject SliceApiClient Api
@inject RefreshTokenHolder TokenHolder
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Item — SliceFx Inbox</PageTitle>

@* h1 is always present so FocusOnNavigate(Selector="h1") fires immediately on navigation *@
<h1>@(_item?.Title ?? "Item")</h1>

@* Constant wrapper: aria-live announces content changes without re-creating the region *@
<div aria-live="polite" aria-busy="@_loading">
    @if (_loading)
    {
        <p><LoadingIndicator /></p>
    }
    else if (_error is not null)
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else if (_item is not null)
    {
        <div class="card">
            <div class="card-url"><a href="@_item.Url" target="_blank" rel="noopener noreferrer">@_item.Url</a></div>
            <div class="card-meta mt-sm">
                <span class="badge @StatusBadgeClass">@_item.Status</span>
                @if (_item.Tags is { Length: > 0 })
                {
                    foreach (var tag in _item.Tags)
                    {
                        <span class="badge badge-tag">@tag</span>
                    }
                }
                <span style="margin-left:.5rem">@_item.Source — @DateFormat.Long(_item.SavedAt)</span>
            </div>
            @if (_item.Description is not null)
            {
                <p class="mt-sm">@_item.Description</p>
            }
        </div>
        <div class="btn-group mt-sm">
            <a href="/" class="btn btn-secondary">&larr; Back to inbox</a>
            <button class="btn btn-secondary" @onclick="ShareAsync" disabled="@_sharing">
                @(_sharing ? "Sharing…" : "Share")
            </button>
        </div>
        @if (_shareMessage is not null)
        {
            <p class="mt-sm" style="font-size:.85rem" role="status">@_shareMessage</p>
        }
        @if (_shareUrl is not null)
        {
            <p class="mt-sm" style="font-size:.85rem">
                Could not copy automatically. Link:
                <a href="@_shareUrl" target="_blank" rel="noopener noreferrer">@_shareUrl</a>
            </p>
        }
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    private bool _loading = true;
    private string? _error;
    private GetItemResponse? _item;
    private bool _sharing;
    private string? _shareMessage;
    private string? _shareUrl;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _item = (await Api.Items.GetItemAsync(Id)).Value;
        }
        catch (SliceApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthRedirect.HandleUnauthorizedAsync(TokenHolder, Nav);
        }
        catch (SliceApiException ex) when ((int?)ex.StatusCode == 404)
        {
            _error = $"Item '{Id}' not found.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load item: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private string StatusBadgeClass => _item?.Status switch
    {
        ItemStatus.Read => "badge-read",
        ItemStatus.Archived => "badge-archived",
        _ => "badge-unread",
    };

    private async Task ShareAsync()
    {
        _shareMessage = null;
        _shareUrl = null;
        _sharing = true;
        try
        {
            var result = (await Api.Share.CreateShareAsync(Id)).Value;
            var shareUrl = $"{Nav.BaseUri.TrimEnd('/')}/s/{result.ShareToken}";
            try
            {
                await JS.InvokeVoidAsync("navigator.clipboard.writeText", shareUrl);
                _shareMessage = $"Copied: {shareUrl}";
            }
            catch
            {
                // Clipboard API requires a Secure Context (https) — fall back to showing the URL
                _shareUrl = shareUrl;
            }
        }
        catch (SliceApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthRedirect.HandleUnauthorizedAsync(TokenHolder, Nav);
        }
        catch (Exception ex)
        {
            _shareMessage = $"Error: {ex.Message}";
        }
        finally { _sharing = false; }
    }
}
