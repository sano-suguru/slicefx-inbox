@implements IDisposable
@page "/feeds"
@inject SliceApiClient Api
@inject RefreshTokenHolder TokenHolder
@inject NavigationManager Nav

<PageTitle>Feeds — SliceFx Inbox</PageTitle>

<h1>Feeds</h1>

@* ── Add feed form ── *@
<div class="card">
    <h2>Subscribe to a feed</h2>
    <EditForm EditContext="_editContext" OnValidSubmit="AddFeedAsync">
        <DataAnnotationsValidator />
        <div class="form-row">
            <label for="feed-url">Feed URL (RSS / Atom)</label>
            <InputText id="feed-url" @bind-Value="_addModel.FeedUrl" placeholder="https://example.com/feed.xml"
                       type="url" inputmode="url" />
            <ValidationMessage For="@(() => _addModel.FeedUrl)" />
        </div>
        <button class="btn btn-primary" type="submit" disabled="@_addBusy">
            @(_addBusy ? "Adding..." : "Subscribe")
        </button>
    </EditForm>
    @if (_addError is not null)
    {
        <div class="alert alert-danger mt-sm" role="alert">@_addError</div>
    }
    @if (_addSuccess)
    {
        <div class="alert alert-success mt-sm" role="status">Subscribed!</div>
    }
</div>

@* ── Refresh trigger ── *@
<div class="card">
    <h2>Manual Refresh</h2>
    <p class="text-muted">
        Fetch all subscribed feeds now and ingest new items.
        (Automatic refresh runs every 30 minutes via GitHub Actions.)
    </p>
    <button class="btn btn-primary" @onclick="RefreshAsync" disabled="@_refreshBusy">
        @(_refreshBusy ? "Refreshing..." : "Refresh feeds")
    </button>
    @if (_refreshResult is not null)
    {
        <div class="alert alert-success mt-sm" role="status">
            Checked @_refreshResult.FeedsChecked feed(s): @_refreshResult.ItemsAdded added,
            @_refreshResult.Skipped skipped, @_refreshResult.Failed failed.
            @if (_refreshResult.ItemsAdded > 0)
            {
                <span>&mdash; <a href="/">View inbox</a></span>
            }
        </div>
    }
    @if (_refreshError is not null)
    {
        <div class="alert alert-danger mt-sm" role="alert">@_refreshError</div>
    }
</div>

@* ── Feed list (constant aria-live wrapper) ── *@
<div aria-live="polite" aria-busy="@_loading">
    @if (_loading)
    {
        <p><LoadingIndicator /></p>
    }
    else if (_loadError is not null)
    {
        <div class="alert alert-danger" role="alert">@_loadError</div>
    }
    else if (_feeds.Length == 0)
    {
        <p>No feeds subscribed yet.</p>
    }
    else
    {
        <p class="text-muted">@_feeds.Length feed(s)</p>
        foreach (var feed in _feeds)
        {
            <div class="card">
                <div class="card-title">
                    <a href="@feed.FeedUrl" target="_blank" rel="noopener noreferrer">
                        @(feed.Title ?? feed.FeedUrl)
                    </a>
                </div>
                <div class="card-url">@feed.FeedUrl</div>
                <div class="card-meta">Added @DateFormat.Short(feed.AddedAt)</div>
            </div>
        }
    }
</div>

@code {
    private AddFeedRequest _addModel = new();
    private EditContext _editContext = default!;
    private ValidationMessageStore _serverErrors = default!;

    private bool _addBusy;
    private bool _addSuccess;
    private string? _addError;
    private CancellationTokenSource? _addSuccessCts;

    private bool _refreshBusy;
    private RefreshFeedsResponse? _refreshResult;
    private string? _refreshError;
    private CancellationTokenSource? _refreshSuccessCts;

    private bool _loading = true;
    private string? _loadError;
    private FeedSubscription[] _feeds = [];

    protected override async Task OnInitializedAsync()
    {
        InitForm();
        TokenHolder.Changed += StateHasChanged;
        await ReloadAsync();
    }

    public void Dispose()
    {
        TokenHolder.Changed -= StateHasChanged;
        _addSuccessCts?.Cancel();
        _refreshSuccessCts?.Cancel();
    }

    private void InitForm()
    {
        _addModel = new();
        _editContext = new EditContext(_addModel);
        _serverErrors = new ValidationMessageStore(_editContext);
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _loadError = null;
        _feeds = [];
        StateHasChanged();
        try
        {
            var resp = (await Api.Feeds.GetFeedsAsync()).Value;
            _feeds = resp.Feeds;
        }
        catch (SliceApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthRedirect.HandleUnauthorizedAsync(TokenHolder, Nav);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load feeds: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddFeedAsync()
    {
        _serverErrors.Clear();
        _addError = null;
        _addSuccess = false;
        _addBusy = true;
        try
        {
            var resp = (await Api.Feeds.AddFeedAsync(_addModel)).Value;
            // Local append to end — Feeds are AddedAt ascending (newest last), so append preserves order.
            _feeds = [.._feeds, new FeedSubscription(resp.Id, resp.FeedUrl, Title: null, resp.AddedAt)];
            InitForm();
            ScheduleAddSuccessClear();
        }
        catch (SliceApiException ex) when (ex.Errors is not null)
        {
            foreach (var (field, messages) in ex.Errors)
            {
                var fi = new FieldIdentifier(_addModel, field);
                foreach (var msg in messages)
                    _serverErrors.Add(fi, msg);
            }
            _editContext.NotifyValidationStateChanged();
        }
        catch (SliceApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthRedirect.HandleUnauthorizedAsync(TokenHolder, Nav);
        }
        catch (Exception ex)
        {
            _addError = $"Error: {ex.Message}";
        }
        finally
        {
            _addBusy = false;
        }
    }

    private void ScheduleAddSuccessClear()
    {
        _addSuccess = true;
        _addSuccessCts?.Cancel();
        _addSuccessCts = new CancellationTokenSource();
        var ct = _addSuccessCts.Token;
        _ = AutoClearAsync(() => _addSuccess = false, 3000, ct);
    }

    private async Task RefreshAsync()
    {
        _refreshError = null;
        _refreshResult = null;
        _refreshBusy = true;
        try
        {
            _refreshResult = (await Api.Feeds.RefreshFeedsAsync()).Value;
            ScheduleRefreshSuccessClear();
        }
        catch (SliceApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthRedirect.HandleUnauthorizedAsync(TokenHolder, Nav);
        }
        catch (Exception ex)
        {
            _refreshError = $"Error: {ex.Message}";
        }
        finally
        {
            _refreshBusy = false;
        }
    }

    private void ScheduleRefreshSuccessClear()
    {
        _refreshSuccessCts?.Cancel();
        _refreshSuccessCts = new CancellationTokenSource();
        var ct = _refreshSuccessCts.Token;
        // Slightly longer delay so users have time to read the result and click "View inbox".
        _ = AutoClearAsync(() => _refreshResult = null, 5000, ct);
    }

    private async Task AutoClearAsync(Action clear, int delayMs, CancellationToken ct)
    {
        try
        {
            await Task.Delay(delayMs, ct);
            clear();
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }
}
