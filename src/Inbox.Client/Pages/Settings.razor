@page "/settings"
@inject SliceApiClient Api
@inject RefreshTokenHolder TokenHolder
@inject NavigationManager Nav

<PageTitle>Settings — SliceFx Inbox</PageTitle>

<h1>Settings</h1>

<div class="card">
    <h2>Workspace Token</h2>
    <p class="text-muted">
        Your workspace token identifies your private inbox. It is kept in <code>sessionStorage</code>
        only — never sent to any server other than this app, and cleared when you close the tab.
        To switch workspaces or log out, clear the token and return to the login screen.
    </p>

    @if (TokenHolder.Token is not null)
    {
        <div class="alert alert-success" role="status">Workspace token is set.</div>
    }
    else
    {
        <div class="alert alert-warning" role="status">No token set. <a href="/login">Sign in</a> to continue.</div>
    }

    <div class="form-row mt-sm">
        <label for="token-input">Paste a token</label>
        <div class="token-bar">
            <input id="token-input" type="password" @bind="_tokenInput" placeholder="Paste workspace token" />
            <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saveBusy">
                @(_saveBusy ? "Verifying…" : "Save")
            </button>
            <button class="btn btn-secondary" @onclick="LogOutAsync" disabled="@(TokenHolder.Token is null)">Log out</button>
        </div>
    </div>

    @if (_saveError is not null)
    {
        <div class="alert alert-danger mt-sm" role="alert">@_saveError</div>
    }
    @if (_saved)
    {
        <div class="alert alert-success mt-sm" role="status">Token saved for this session.</div>
    }
</div>

@code {
    private string _tokenInput = "";
    private bool _saved;
    private bool _saveBusy;
    private string? _saveError;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_tokenInput)) return;
        _saveError = null;
        _saved = false;
        _saveBusy = true;
        try
        {
            await TokenHolder.SetAsync(_tokenInput);
            // Validate with a lightweight call before confirming success.
            await Api.Feeds.GetFeedsAsync();
            _tokenInput = "";
            _saved = true;
        }
        catch (SliceApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await TokenHolder.SetAsync(null);
            _tokenInput = "";
            _saveError = "Invalid token. Please check and try again.";
        }
        catch (Exception ex)
        {
            _saveError = $"Error: {ex.Message}";
        }
        finally
        {
            _saveBusy = false;
        }
    }

    private async Task LogOutAsync()
    {
        await TokenHolder.SetAsync(null);
        _saved = false;
        Nav.NavigateTo("/login");
    }
}
