@implements IDisposable
@inherits LayoutComponentBase
@inject RefreshTokenHolder TokenHolder
@inject ISessionStorage Storage
@inject NavigationManager Nav

<nav class="nav" aria-label="Primary">
    <NavLink class="nav-title" href="/" Match="NavLinkMatch.All">SliceFx Inbox</NavLink>
    <span>
        @if (TokenHolder.Token is not null)
        {
            <NavLink href="/" Match="NavLinkMatch.All">Items</NavLink>
            <NavLink href="/feeds">Feeds</NavLink>
            <NavLink href="/settings">Settings</NavLink>
            <button class="btn btn-secondary btn-sm" style="margin-left:1rem"
                    @onclick="LogOutAsync">Log out</button>
        }
        else
        {
            <NavLink href="/login">Sign in</NavLink>
        }
    </span>
</nav>

@if (!_initialized)
{
    @* Suppress body flash before token hydration and route-guard redirect complete *@
    <div class="container" aria-live="polite" aria-busy="true">
        <p><LoadingIndicator /></p>
    </div>
}
else
{
    <main class="container">
        @if (_isDemoMode)
        {
            <div class="alert alert-warning" role="status">
                You're in the shared demo workspace &mdash; everyone can read and edit this data.
                <a href="/login">Create your own workspace &rarr;</a>
            </div>
        }
        @Body
    </main>
}

@code {
    private bool _initialized;
    private bool _isDemoMode;

    protected override async Task OnInitializedAsync()
    {
        await TokenHolder.InitializeAsync();

        // Route guard: redirect to /login if no token, unless already there.
        if (TokenHolder.Token is null)
        {
            var path = new Uri(Nav.Uri).AbsolutePath;
            if (!path.Equals("/login", StringComparison.OrdinalIgnoreCase))
                Nav.NavigateTo("/login");
        }

        _isDemoMode = TokenHolder.Token == DemoWorkspace.Token;
        _initialized = true;
        TokenHolder.Changed += OnTokenChanged;
    }

    private void OnTokenChanged()
    {
        _isDemoMode = TokenHolder.Token == DemoWorkspace.Token;
        StateHasChanged();
    }

    private async Task LogOutAsync()
    {
        await TokenHolder.SetAsync(null);
        Nav.NavigateTo("/login");
    }

    public void Dispose() => TokenHolder.Changed -= OnTokenChanged;
}
