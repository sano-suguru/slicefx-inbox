@implements IDisposable
@inherits LayoutComponentBase
@inject RefreshTokenHolder TokenHolder
@inject ISessionStorage Storage
@inject NavigationManager Nav

<nav class="nav">
    <a class="nav-title" href="/">SliceFx Inbox</a>
    <span>
        <a href="/">Items</a>
        <a href="/feeds">Feeds</a>
        <a href="/settings">Settings</a>
    </span>
</nav>

@if (!_initialized)
{
    @* Suppress body flash before token hydration and route-guard redirect complete *@
    <div class="container"><p>Loading...</p></div>
}
else
{
    <div class="container">
        @if (_isDemoMode)
        {
            <div class="alert alert-warning">
                You're in the shared demo workspace &mdash; everyone can read and edit this data.
                <a href="/login">Create your own workspace &rarr;</a>
            </div>
        }
        @Body
    </div>
}

@code {
    // MUST stay in sync with Inbox.Server WorkspaceProvisioner.DemoToken.
    // The server's DemoToken is internal const — cannot be referenced from the client.
    // If the demo token value changes server-side, update this constant too.
    private const string DemoToken = "demo-access-token";

    private bool _initialized;
    private bool _isDemoMode;

    protected override async Task OnInitializedAsync()
    {
        await TokenHolder.InitializeAsync();

        // Route guard: redirect to /login if no token, unless already there.
        if (TokenHolder.Token is null)
        {
            var path = new Uri(Nav.Uri).AbsolutePath;
            if (!path.Equals("/login", StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/login");
                return;
            }
        }

        _isDemoMode = TokenHolder.Token == DemoToken;
        _initialized = true;
        TokenHolder.Changed += OnTokenChanged;
    }

    private void OnTokenChanged()
    {
        _isDemoMode = TokenHolder.Token == DemoToken;
        StateHasChanged();
    }

    public void Dispose() => TokenHolder.Changed -= OnTokenChanged;
}
