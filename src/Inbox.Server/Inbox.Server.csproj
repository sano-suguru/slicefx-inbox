<Project>

  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <RootNamespace>Inbox.Server</RootNamespace>
    <OutputType>Library</OutputType>
    <SliceFxRole>Both</SliceFxRole>
    <!-- CS1591: XML doc comments are not required for WASI application entry-point and feature code. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- WASI publish settings -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'wasi-wasm'">
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- DebugType=none prevents NativeAOT-LLVM from emitting DWARF debug sections into the .wasm,
         keeping the output at ~25MB without any post-build strip step or external wasm-tools.
         Source: runtimelab docs/using-nativeaot/compiling.md -->
    <DebugType>none</DebugType>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-experimental/nuget/v3/index.json;https://api.nuget.org/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <CompilerVisibleProperty Include="SliceFxRole" />
    <Using Include="SliceFx" />
  </ItemGroup>

  <!-- SliceFx packages (NuGet only — no ProjectReference; pack-path bug detection) -->
  <ItemGroup>
    <PackageReference Include="SliceFx.Core" Version="0.1.0-preview.17" />
    <PackageReference Include="SliceFx.Wasi" Version="0.1.0-preview.17" />
    <PackageReference Include="SliceFx.Wasi.KeyValue" Version="0.1.0-preview.16" />
    <PackageReference Include="SliceFx.Wasi.HttpClient" Version="0.1.0-preview.17" />
    <PackageReference Include="SliceFx.Wasi.Spin" Version="0.1.0-preview.16" />
    <PackageReference Include="SliceFx.SourceGenerator" Version="0.1.0-preview.16"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inbox.Contracts\Inbox.Contracts.csproj" />
  </ItemGroup>

  <!-- Files that use WIT-generated types — excluded from non-WASI builds -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != 'wasi-wasm'">
    <Compile Remove="IncomingHandlerImpl.cs" />
    <Compile Remove="InboxApp.cs" />
    <Compile Remove="CronHandlerBridge.cs" />
    <Compile Remove="Infrastructure/SpinKeyValueStore.cs" />
    <Compile Remove="Infrastructure/SpinWasiHttpClient.cs" />
    <Compile Remove="Infrastructure/FeedRefreshCronHandler.cs" />
    <Compile Remove="Infrastructure/SpinVariables.cs" />
  </ItemGroup>

  <!-- componentize-dotnet + NativeAOT-LLVM (WASI publish only) -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'wasi-wasm'">
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" Version="0.8.0-preview00011" />
    <!-- System.Xml.XmlReader is trim-safe; no TrimmerRootAssembly needed after FeedParser was
         rewritten from XDocument/XElement (System.Xml.Linq) to XmlReader (System.Xml). -->
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'wasi-wasm' and ('$(NETCoreSdkPortableRuntimeIdentifier)' == 'linux-x64' or '$(NETCoreSdkPortableRuntimeIdentifier)' == 'win-x64')">
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).microsoft.dotnet.ilcompiler.llvm" Version="10.0.0-rc.1.26306.1" />
  </ItemGroup>

  <!-- WIT world: proxy + fermyon:spin/key-value@2.0.0 (combined text WIT) -->
  <!-- Spike 2: combined.wit extends wasi:http/proxy with Spin key-value import -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'wasi-wasm'">
    <Wit Include="wit/combined.wit" World="proxy" />
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />

  <!-- Break circular dep introduced by componentize-dotnet's PublishAfterBuild -->
  <Target Name="PublishAfterBuild" Condition="'$(RuntimeIdentifier)' == 'wasi-wasm'" />

  <Target Name="FailUnsupportedWasiPublishHost"
          BeforeTargets="Restore;Build;Publish"
          Condition="'$(RuntimeIdentifier)' == 'wasi-wasm' and '$(NETCoreSdkPortableRuntimeIdentifier)' != 'linux-x64' and '$(NETCoreSdkPortableRuntimeIdentifier)' != 'win-x64'">
    <Error Text="Inbox.Server WASI publish requires a NativeAOT-LLVM host package. Supported hosts: linux-x64, win-x64. On macOS, use Docker linux/amd64." />
  </Target>

  <Target Name="CopyWasiWasmComponent" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'wasi-wasm' and Exists('$(NativeOutputPath)$(MSBuildProjectName).wasm')">
    <MakeDir Directories="$(MSBuildProjectDirectory)\dist" />
    <Copy SourceFiles="$(NativeOutputPath)$(MSBuildProjectName).wasm"
          DestinationFiles="$(MSBuildProjectDirectory)\dist\inbox-server.wasm" />
  </Target>

</Project>
